{
  "productName": "Lumina",
  "version": "3.6.0",
  "identifier": "com.amazhr.lumina",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumina \u2014 AI Photo Triage",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": false
      },
      {
        "title": "Lumina",
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 480,
        "height": 320,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://*.tile.openstreetmap.org",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost data: blob: http://localhost:1420 https://*.tile.openstreetmap.org",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "font-src": "'self' data: http://localhost:1420",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "target/release/DirectML.dll": "DirectML.dll"
    },
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "amazHR",
    "shortDescription": "Local AI Photo Culling & Studio Organizer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "perMachine",
        "compression": "lzma"
      }
    }
  }
}