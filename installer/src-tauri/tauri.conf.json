{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina Setup",
  "version": "4.3.0",
  "identifier": "com.amazhr.lumina.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumina Setup",
        "width": 860,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
